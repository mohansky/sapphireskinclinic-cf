---
// src/pages/treatments/[slug].astro
export const prerender = true;
import SideBarIcon from "@/components/icons/SideBarIcon.astro";
import BeforeAfter from "@/components/sections/BeforeAfter.astro";
import PageHero from "@/components/sections/PageHero.astro";
import TreatmentSchema from "@/components/schema/TreatmentSchema.astro";
import Container from "@/components/ui/Container.astro";
import Heading from "@/components/ui/Heading.astro";
import ListItem from "@/components/ui/ListItem.astro";
import ListUnordered from "@/components/ui/ListUnordered.astro";
import Paragraph from "@/components/ui/Paragraph.astro";
import R2Image from "@/components/ui/R2Image.astro";
import TreatmentsCardMenu from "@/components/ui/TreatmentsCardMenu.astro";
import TreatmentInfoCard from "@/components/ui/TreatmentInfoCard.astro";
import Accordion from "@/components/ui/Accordion.astro";
import Layout from "@/layouts/Layout.astro";
import { getCollection, getEntry, render } from "astro:content";

const treatmentsCollection = await getCollection("treatments", ({ data }) => {
  return data.draft !== true;
});
const sortedTreatments = treatmentsCollection.sort(
  (a, b) => a.data.weight - b.data.weight,
);

export async function getStaticPaths() {
  const publishedTreatments = await getCollection("treatments", ({ data }) => {
    return data.draft !== true;
  });
  return publishedTreatments.map((treatment) => ({
    params: { slug: treatment.id },
    props: { treatment },
  }));
}

const { treatment } = Astro.props;

const entry = await getEntry("treatments", treatment.id);
if (!entry) {
  throw new Error("Could not find service with id: " + treatment.id);
}
const { Content } = await render(entry);

// Prepare FAQ items for Accordion component
const faqItems =
  treatment.data.faq?.map((faq: { question: string; answer: string }) => ({
    title: faq.question,
    content: faq.answer,
  })) || [];
---

<!-- <Layout>  -->
<Layout
  title={`${treatment.data.title} - Sapphire Skin & Aesthetics Clinic`}
  description={treatment.data.description}
  image={treatment.data.img || undefined}
  treatment={treatment}
>
  <TreatmentSchema treatment={treatment} />
  <PageHero hero={treatment.data} />
  <Container width="marginxy">
    <div class="grid lg:grid-cols-5 gap-10">
      <div class="col-span-3">
        <Heading 
          size="xxl"
          fontweight="black"
          fontstyle="point"
          class="mb-5">{treatment.data.title}</Heading
        >
        <!-- Mobile: Show info card below content -->
        <div class="lg:hidden mt-6">
          <TreatmentInfoCard treatment={treatment} />
        </div>
        <div class="treatment-content">
          <R2Image
            src={treatment.data.img}
            alt={treatment.data.title}
            title={treatment.data.title}
            class="float-right ml-6 mb-4 w-full sm:w-1/2 lg:w-2/5 rounded-lg"
            width={800}
            height={600}
          />
          <Content
            components={{
              h1: Heading,
              h2: Heading,
              h3: Heading,
              h4: Heading,
              h5: Heading,
              h6: Heading,
              p: Paragraph,
              li: ListItem,
              ul: ListUnordered,
            }}
          />
        </div>
      </div>
      <div class="col-span-2 hidden lg:block">
        <div class="sticky top-24">
          <TreatmentInfoCard treatment={treatment} />
        </div>
      </div>
    </div>

    <div class="grid lg:grid-cols-2 gap-10 mt-10">
      {
        faqItems.length > 0 ? (
          <div>
            <Heading
              size="sm"
              fontweight="medium"
              fontstyle="point"
              class="mb-4"
            >
              Frequently Asked Questions about {treatment.data.title}
            </Heading>
            <Accordion
              items={faqItems}
              id={`faq-${treatment.id}`}
              defaultOpen={0}
            />
          </div>
        ) : null
      }

      <div class="clear-both">
        <BeforeAfter
          before={treatment.data.before}
          after={treatment.data.after}
        />
      </div>
    </div>
  </Container>
  <section class="my-20 mx-10">
    <ul class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-4">
      {
        sortedTreatments.map((treatment) => (
          <li class="group z-50">
            <a
              href={"/treatments/" + treatment.id}
              title={treatment.data.title}
              class="block w-full h-full"
            >
              <TreatmentsCardMenu
                treatmentItems={{
                  title: treatment.data.title || "",
                  description: treatment.data.description,
                  img: treatment.data.img,
                  icon: treatment.data.icon,
                  id: treatment.id,
                }}
              />
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
