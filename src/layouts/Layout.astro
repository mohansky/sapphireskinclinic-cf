---
import "@/styles/global.css";
import Head from "@/components/layout/Head.astro";
import GTMBodyNoScript from "@/components/layout/GTMBodyNoScript.astro"; 
import Navbar from "@/components/layout/Navbar.astro"; 
import Footer from "@/components/layout/Footer.astro";

import { getCollection } from "astro:content";

const siteData = await getCollection("siteCollection");
const siteInfo = siteData[0].data;
const site = siteInfo;

// Accept props for page-specific data
interface Props {
  title?: string;
  description?: string;
  image?: string;
  treatment?: any;
}

const { title, description, image, treatment } = Astro.props;

// Build breadcrumbs based on current path
const getBreadcrumbs = (): Array<{ name: string; url: string }> | undefined => {
  const currentPath = Astro.url.pathname;
  const base = [{ name: "Home", url: `${site.basepath}/` }];
  
  if (currentPath.includes('/about')) {
    return [...base, { name: "About", url: Astro.url.href }];
  }
  
  if (currentPath.includes('/treatments/') && treatment) {
    return [
      ...base,
      { name: "Treatments", url: `${site.basepath}/treatments` },
      { name: String(treatment.data.title), url: Astro.url.href }
    ];
  }
  
  if (currentPath.includes('/treatments')) {
    return [...base, { name: "Treatments", url: Astro.url.href }];
  }
  
  if (currentPath.includes('/contact')) {
    return [...base, { name: "Contact", url: Astro.url.href }];
  }
  
  if (currentPath.includes('/gallery')) {
    return [...base, { name: "Gallery", url: Astro.url.href }];
  }
  
  if (currentPath.includes('/blog')) {
    return [...base, { name: "Blog", url: Astro.url.href }];
  }
  
  if (currentPath === '/') {
    return undefined;
  }
  
  return base;
};

// CALL THE FUNCTION and assign to breadcrumbs variable
const breadcrumbs = getBreadcrumbs();
---

<!doctype html>
<html lang="en" data-theme="ssac">
  <Head 
    title={title}
    description={description}
    image={image}
    treatment={treatment}
    breadcrumbs={breadcrumbs}
  />
  
  <body class="overflow-x-hidden">
    <GTMBodyNoScript />
    <Navbar navigation={site.navigation} />
    <slot />
    <Footer
      footer={{
        name: site.name,
        copyright: site.copyright,
        social_media: site.social_media,
        locations: site.locations,
        footerLatestOffers: site.footerLatestOffers,
        footerBookAppointment: site.footerBookAppointment,
        popularTreatments: site.popularTreatments,
        usefulLinks: site.usefulLinks,
      }}
    />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>