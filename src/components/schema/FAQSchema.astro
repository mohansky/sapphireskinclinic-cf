---
import { getCollection } from "astro:content";
const siteData = await getCollection("siteCollection");
const site = siteData[0].data;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": site.faq?.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  })) || []
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema, null, 2)}></script>