---
import GTMHeadScript from "@/components/layout/GTMHeadScript.astro";
import Schema from "@/components/schema/Schema.astro";
import FAQSchema from '@/components/schema/FAQSchema.astro';
import VideoSchema from '@/components/schema/VideoSchema.astro';
import LocationSchema from '@/components/schema/LocationSchema.astro';
import BreadcrumbSchema from '@/components/schema/BreadcrumbSchema.astro';
import TreatmentSchema from '@/components/schema/TreatmentSchema.astro';
import { getCollection } from "astro:content";

const siteData = await getCollection("siteCollection");
const siteInfo = siteData[0].data;
const site = siteInfo;

// Accept props for page-specific data
interface Props {
  title?: string;
  description?: string;
  image?: string;
  treatment?: any;
  breadcrumbs?: Array<{ name: string; url: string }>;
}

const { 
  title = site.title, 
  description = site.description, 
  image = site.ogImageURL,
  treatment,
  breadcrumbs
} = Astro.props;

// Determine page type from URL
const currentPath = Astro.url.pathname;
const isHome = currentPath === '/';
const isAbout = currentPath.includes('/about');
const isTreatment = currentPath.includes('/treatments/') && treatment;
---

<head>
  <script>
    import "/src/scripts/theme.ts";
  </script>
  <meta charset="UTF-8" />
  <link rel="sitemap" href="/sitemap-index.xml" />

  <!-- Schema.org -->
  <!-- Always include main schema -->
  <Schema />
  <!-- Include location schemas on all pages -->
  <LocationSchema />
  <!-- Conditionally include based on page -->
  {isHome && <VideoSchema />}
  {isAbout && <FAQSchema />}
  {isTreatment && <TreatmentSchema treatment={treatment} />}
  {breadcrumbs && <BreadcrumbSchema items={breadcrumbs} />}

  <!-- DaisyUI -->
  <link
    href="https://cdn.jsdelivr.net/npm/daisyui@5.0.0-beta.6/daisyui.css"
    rel="stylesheet"
    type="text/css"
  />

  <!-- Tailwind -->
  <script
    type="text/partytown"
    src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"
    is:inline></script>

  <link rel="sitemap" href="/sitemap.xml" />
  <!-- Basic Meta Tags -->

  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="generator" content={Astro.generator} />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="publisher" content={site.title} />

  <!-- Open Graph Meta Tags (for social sharing) -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={`${site.basepath}${image}`} />
  <meta property="og:url" content={Astro.url.href} />
  <meta property="og:type" content="website" />

  <!-- Twitter Card Meta Tags -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${site.basepath}${image}`} />

  <!-- Canonical URL (prevents duplicate content issues) -->
  <link rel="canonical" href={Astro.url.href} />

  <!-- Additional SEO Meta Tags -->
  <meta name="robots" content="index, follow" />
  <meta name="keywords" content={site.keywords.join(",")} />
  <meta name="author" content={site.author.name} />
  <GTMHeadScript />
</head>