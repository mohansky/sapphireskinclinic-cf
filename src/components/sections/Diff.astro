---
import { Image } from "astro:assets";
import before from "../../assets/derma-roller-for-acne-scars-before.jpg";
import after from "../../assets/derma-roller-for-acne-scars-after.jpg";
import Container from "../ui/Container.astro";
import Heading from "../ui/Heading.astro";
import R2Image from "../ui/R2Image.astro";
---

<Container>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-8 place-content-center">
    <Heading> Before after </Heading>

    <figure class="diff aspect-video max-h-96" tabindex="0">
      <div class="diff-item-1" role="img" tabindex="0">
        <R2Image src={before} title="before" alt="before" class="object-contain" />
      </div>
      <div class="diff-item-2 p-4" role="img">
        <R2Image src={after} title="after" alt="after" class="object-contain" />
      </div>
      <div class="diff-resizer"></div>
    </figure>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-8 place-content-center">
    <figure class="diff aspect-video" tabindex="0">
      <div class="diff-item-1" role="img" tabindex="0">
        <R2Image src={before} alt="Before treatment" class="object-contain" />
      </div>
      <div class="diff-item-2 p-4" role="img">
        <R2Image src={after} alt="After treatment" class="object-contain" />
      </div>
      <div class="diff-resizer"></div>
    </figure>
    <Heading> Before after </Heading> 
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-8 place-content-center">
    <Heading> Before after </Heading>
    <figure class="diff aspect-video" tabindex="0">
      <div class="diff-item-1" role="img" tabindex="0">
        <R2Image src={before} alt="Before treatment" class="object-contain" />
      </div>
      <div class="diff-item-2 p-4" role="img">
        <R2Image src={after} alt="After treatment" class="object-contain" />
      </div>
      <div class="diff-resizer"></div>
    </figure>
  </div>
</Container>
