---
import Heading from "../ui/Heading.astro";
import R2Image from "../ui/R2Image.astro";

interface HeroContent {
  title: string;
  category?: string;
  img: string; // Changed from ImageMetadata to string for R2 paths
  overlayOpacity?: number;
}

interface Props {
  hero: HeroContent;
}

const {
  title,
  category,
  img,
  overlayOpacity = 0.2,
} = Astro.props.hero;
---

<div class="hero min-h-[60vh] relative">
  <R2Image
    src={img}
    alt={title}
    title={title}
    width={1000}
    height={500}
    quality={80}
    class="absolute inset-0 w-full h-full object-top object-cover"
  />
  <div
    class="hero-overlay opacity-50 absolute inset-0"
    style={`background-opacity: ${overlayOpacity}`}
  >
  </div>
  <div
    class="hero-content text-center text-neutral-content absolute top-1/2 left-1/2 -translate-y-1/2 -translate-x-1/2"
  >
    <div class="max-w-7xl">
      <Heading
        as="h1"
        size="xxl"
        fontweight="black"
        fontstyle="point"
        variant="sectiontitle"
        class="text-neutral-content text-balance">{title}</Heading
        >
        {
          category && (
            <Heading
              size="sm"
              fontweight="normal"
              fontstyle="glory"
              class="text-neutral-content tracking-wide opacity-75 mb-5"
              variant="sectiontitle"
            
            >
              {category}
            </Heading>
          )
        }
    </div>
  </div>
</div>
