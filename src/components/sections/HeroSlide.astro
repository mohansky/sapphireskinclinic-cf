---
import Heading from "../ui/Heading.astro";
import Button from "../ui/Button.astro";
interface HeroContent {
  title: string;
  subtitle?: string;
  backgroundImage: string;
  overlayOpacity?: number;
  primaryButtonText?: string;
  primaryButtonLink?: string;
  secondaryButtonText?: string;
  secondaryButtonLink?: string;
  isFirstSlide?: boolean;
}
interface Props {
  hero: HeroContent;
}
const {
  title,
  subtitle,
  backgroundImage,
  overlayOpacity,
  primaryButtonText,
  primaryButtonLink,
  secondaryButtonText,
  secondaryButtonLink,
  isFirstSlide = false,
} = Astro.props.hero;

// Build direct R2 URL (bypasses /_image proxy for faster LCP)
const R2_PUBLIC_URL = import.meta.env.R2_PUBLIC_URL || process.env.R2_PUBLIC_URL;
const cleanPath = backgroundImage.startsWith("/") ? backgroundImage.slice(1) : backgroundImage;
const imageUrl = R2_PUBLIC_URL ? `${R2_PUBLIC_URL}/${cleanPath}` : backgroundImage;
---

<div class="swiper-slide hero min-h-screen relative">
  <img
    src={imageUrl}
    alt={title}
    title={title}
    width="1920"
    height="1080"
    loading={isFirstSlide ? "eager" : "lazy"}
    fetchpriority={isFirstSlide ? "high" : "low"}
    decoding={isFirstSlide ? "sync" : "async"}
    class="absolute inset-0 w-full h-full object-cover"
  />
  <div class="hero-overlay opacity-50 absolute inset-0"></div>
  <div
    class="hero-content text-center text-neutral-content z-10 absolute top-1/2 left-1/2 -translate-y-1/2 -translate-x-1/2"
  >
    <div class="w-full">
      <Heading
        size="sm"
        fontweight="normal"
        fontstyle="glory"
        class="text-neutral-content tracking-wide opacity-75"
        variant="sectiontitle"
        as={isFirstSlide ? "h1" : "h2"}>Sapphire Skin & Aesthetics Clinic</Heading
      >
      <Heading
        size="xxxl"
        fontweight="black"
        fontstyle="point"
        variant="sectiontitle"
        class="text-neutral-content text-balance mb-5 mt-3">{title}</Heading
      >
      {
        subtitle && (
          <Heading
            variant="sectiontitle"
            fontstyle="poppins"
            fontweight="light"
            size="md" 
            class="text-neutral-content text-balance"
          >
            {subtitle}
          </Heading>
        )
      }
      <div class="flex flex-col md:flex-row justify-center gap-4 mt-10">
        {
          primaryButtonText && primaryButtonLink && (
            <Button
              color="primary"
              href={primaryButtonLink}
              title={primaryButtonText}
              themed
            >
              {primaryButtonText}
            </Button>
          )
        }
        {
          secondaryButtonText && secondaryButtonLink && (
            <Button
              variant="soft"
              color="primary"
              href={secondaryButtonLink}
              title={secondaryButtonText}
              themed
            >
              {secondaryButtonText}
            </Button>
          )
        }
      </div>
    </div>
  </div>
</div>
